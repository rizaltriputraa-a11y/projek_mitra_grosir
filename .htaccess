<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lindungi file dan folder Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor)(/|$) - [F,L,NC]

    # Lindungi file sensitif
    RewriteRule ^(\.env|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$ - [F,L,NC]

    # Arahkan semua request ke folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>